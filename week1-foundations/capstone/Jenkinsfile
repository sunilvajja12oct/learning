pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                sh 'docker build -t capstone-app week1-foundations/capstone'
            }
        }
        stage('Security Scan') {
            steps {
                sh 'docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy image --exit-code 0 --severity HIGH,CRITICAL capstone-app'
            }
        }
        stage('Deploy') {
            steps {
                sh 'docker rm -f capstone-app-container || true'
                sh 'docker run -d --name capstone-app-container --network ci-net -p 8000:8000 capstone-app'
                sh '''
                    for i in $(seq 1 10); do
                        if curl -s -o /dev/null http://capstone-app-container:8000/health; then
                            echo "Container is up after $i attempt(s)"
                            break
                        fi
                        echo "Not ready yet, retry $i"
                        sleep 2
                    done
                '''
            }
        }
        stage('Test') {
            steps {
                sh 'chmod +x week1-foundations/capstone/healthcheck.sh'
                sh './week1-foundations/capstone/healthcheck.sh http://capstone-app-container:8000/health'
            }
        }
    }
    post {
        always {
            sh 'docker rm -f capstone-app-container || true'
        }
    }
}